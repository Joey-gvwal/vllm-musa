From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Tue, 27 Oct 2026 10:43:07 +0800
Subject: [PATCH] MUSA: allocate Mamba state in dedicated KV-cache pools

---
 vllm/v1/core/kv_cache_coordinator.py |  19 ++++-
 vllm/v1/core/kv_cache_utils.py       | 113 +++++++++++++++++++++++++++
 vllm/v1/kv_cache_interface.py        |  11 +++
 3 files changed, 142 insertions(+), 1 deletion(-)

diff --git a/vllm/v1/core/kv_cache_coordinator.py b/vllm/v1/core/kv_cache_coordinator.py
index 7d4f2d5a2b..c69ea19417 100644
--- a/vllm/v1/core/kv_cache_coordinator.py
+++ b/vllm/v1/core/kv_cache_coordinator.py
@@ -11,6 +11,7 @@ from vllm.v1.core.kv_cache_utils import (
     BlockHash,
     KVCacheBlock,
     eagle_proof_margin,
+    musa_mamba_separate_pool_enabled,
     partial_hash_hits_enabled,
 )
 from vllm.v1.core.single_type_kv_cache_manager import (
@@ -124,6 +125,19 @@ class KVCacheCoordinator(ABC):
             metrics_collector=metrics_collector,
         )
 
+        self.musa_mamba_block_pools: dict[int, BlockPool] = {}
+        musa_mamba_num_blocks = kv_cache_config.musa_mamba_num_blocks
+        if musa_mamba_separate_pool_enabled() and musa_mamba_num_blocks:
