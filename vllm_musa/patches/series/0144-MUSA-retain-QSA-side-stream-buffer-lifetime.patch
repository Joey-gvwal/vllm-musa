From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Joey-gvwal <joey_gvwal@yeah.net>
Date: Mon, 14 Sep 2026 16:48:41 +0800
Subject: [PATCH] MUSA: retain QSA side-stream buffer lifetime

---
 vllm/models/qwen4_exp/nvidia/qsa.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/vllm/models/qwen4_exp/nvidia/qsa.py b/vllm/models/qwen4_exp/nvidia/qsa.py
index 4131bdf2ac..f290cb392e 100644
--- a/vllm/models/qwen4_exp/nvidia/qsa.py
+++ b/vllm/models/qwen4_exp/nvidia/qsa.py
@@ -435,6 +435,10 @@ class Qwen4ExpQSAAttention(Qwen3NextAttention, AttentionLayerBase):
             with torch.musa.stream(self._indexer_stream):
                 projected_qk, _ = self.indexer.index_qk_proj(hidden_states)
             current_stream.wait_stream(self._indexer_stream)
+            # The projection buffer is allocated on the side stream and
+            # consumed by the current-stream QSA op. Record that dependency so
+            # the caching allocator cannot recycle it before consumption.
+            projected_qk.record_stream(current_stream)
         else:
             projected_qk, _ = self.indexer.index_qk_proj(hidden_states)
         qkv, _ = self.qkv_proj(hidden_states)
