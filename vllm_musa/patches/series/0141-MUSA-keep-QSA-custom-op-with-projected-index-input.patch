From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Mon, 14 Sep 2026 10:33:52 +0800
Subject: [PATCH] MUSA: keep QSA custom op with projected index input

---
 vllm/models/qwen4_exp/nvidia/qsa.py | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/vllm/models/qwen4_exp/nvidia/qsa.py b/vllm/models/qwen4_exp/nvidia/qsa.py
index b368318963..b2c3df2b29 100644
--- a/vllm/models/qwen4_exp/nvidia/qsa.py
+++ b/vllm/models/qwen4_exp/nvidia/qsa.py
@@ -9,6 +9,7 @@ from typing import ClassVar, cast
 import torch
 from torch import nn
 
+from vllm.compilation.breakable_cudagraph import eager_break_during_capture
 from vllm.config import VllmConfig
 from vllm.config.cache import CacheDType
 from vllm.distributed import get_tensor_model_parallel_world_size
@@ -360,9 +361,10 @@ class Qwen4ExpQSAAttention(Qwen3NextAttention, AttentionLayerBase):
             indexes_kv_by_block_stride=True,
         )
 
+    @eager_break_during_capture
     def _run_qsa(
         self,
-        hidden_states: torch.Tensor,
+        projected_qk: torch.Tensor,
         positions: torch.Tensor,
         query: torch.Tensor,
         key: torch.Tensor,
@@ -387,7 +389,7 @@ class Qwen4ExpQSAAttention(Qwen3NextAttention, AttentionLayerBase):
         if side_metadata.num_actual_tokens != num_tokens:
             raise RuntimeError("QSA main and side metadata token counts disagree")
         selected = self.indexer(
-            hidden_states,
+            projected_qk,
             positions,
             self.topk_indices_buffer[:num_tokens],
         )
@@ -473,8 +475,11 @@ def qwen4_exp_qsa_with_output(
     layer = get_forward_context().no_compile_layers[layer_name]
     if not isinstance(layer, Qwen4ExpQSAAttention):
         raise TypeError(f"{layer_name} is not a Qwen4Exp QSA owner")
+    # Keep the index projection outside the eager-break region while retaining
+    # the MUSA opaque custom-op boundary used by CUDA-graph capture.
+    projected_qk, _ = layer.indexer.index_qk_proj(hidden_states)
     layer._run_qsa(
-        hidden_states,
+        projected_qk,
         positions,
         query,
         key,
