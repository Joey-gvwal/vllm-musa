From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wzc-claude <wzc-claude@local>
Date: Wed, 8 Oct 2026 10:00:00 +0800
Subject: [PATCH] MUSA: make the QSA TileLang prefill kernel the default

The prefill kernel is never slower than the Triton path and is 20% better on
time-to-first-token at short context, so it no longer needs a gate. The decode
kernel costs 2.5% per output token at every context measured, so it stays behind
VLLM_MUSA_QSA_TILELANG_DECODE and decode keeps using the Triton path.

The tilelang_ok capability gate is unchanged, so an unsupported dtype, head
count, head size or non-contiguous page layout still takes the Triton sparse
paged attention path. The pre-capture prewarm now always runs, since the prefill
kernel it builds is always reachable.

---
--- a/vllm/models/qwen4_exp/nvidia/qsa.py
+++ b/vllm/models/qwen4_exp/nvidia/qsa.py
@@ -190,7 +190,6 @@
         if key_cache.dtype != torch.bfloat16 or query.dtype != torch.bfloat16:
             raise NotImplementedError("Qwen4Exp QSA requires BF16 Q/K/V")
 
-        tilelang_mode = os.environ.get("VLLM_MUSA_QSA_TILELANG", "")
         tilelang_ok = (
             current_platform.is_musa()
             and query.dtype == torch.bfloat16
@@ -201,19 +200,12 @@
             and _is_page_contiguous_cache(value_cache)
         )
 
-        if tilelang_ok and use_prefill_config and tilelang_mode in ("1", "legacy"):
-            if tilelang_mode == "legacy":
-                from vllm_musa.jit_kernel.tilelang.qsa_sparse_attn import (
-                    qsa_prefill_attention as qsa_prefill,
-                )
-            else:
-                from vllm_musa.jit_kernel.tilelang.qsa_sparse_attn_v2 import (
-                    qsa_prefill_attention_v2 as qsa_prefill,
-                )
-
-            logger.info_once(
-                "QSA prefill routed to the TileLang kernel (mode=%s)", tilelang_mode
+        if tilelang_ok and use_prefill_config:
+            from vllm_musa.jit_kernel.tilelang.qsa_sparse_attn_v2 import (
+                qsa_prefill_attention_v2 as qsa_prefill,
             )
+
+            logger.info_once("QSA prefill routed to the TileLang kernel")
             return qsa_prefill(
                 query[:num_tokens],
                 key_cache,
@@ -430,10 +422,6 @@
         """
         if not current_platform.is_musa():
             return
-        if os.environ.get("VLLM_MUSA_QSA_TILELANG", "") not in ("1", "legacy") and (
-            os.environ.get("VLLM_MUSA_QSA_TILELANG_DECODE") != "1"
-        ):
-            return
         try:
             from vllm_musa.jit_kernel.tilelang.qsa_sparse_attn_v2 import (
                 prewarm_qsa_kernels,
