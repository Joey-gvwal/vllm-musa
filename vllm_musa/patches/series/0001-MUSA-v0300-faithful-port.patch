+
+    @classmethod
+    def enabled(cls) -> bool:
+        return os.environ.get(cls._GRAPH_ENV, "0") == "1"
+
+    @staticmethod
+    def _is_musa_runtime() -> bool:
+        return getattr(torch.version, "musa", None) is not None
+
+    @staticmethod
