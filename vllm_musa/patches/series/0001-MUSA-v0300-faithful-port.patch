+    ) -> dict[str, torch.Tensor | None]:
+        buffers: dict[str, torch.Tensor | None] = {
+            "max_seqlen": metadata.get("max_seqlen"),
+        }
+        for key in self._META_KEYS:
+            src = metadata.get(key)
+            if src is None:
+                buffers[key] = None
+            elif src.device.type == "cpu":
+                buffers[key] = src
