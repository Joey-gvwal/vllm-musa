+  m.impl("convert_fp8", torch::kPrivateUse1, &mcb::convert_fp8);
+
+  m.def(
+      "gather_and_maybe_dequant_cache(Tensor src_cache, Tensor! dst, "
+      "                               Tensor block_table, Tensor cu_seq_lens, "
