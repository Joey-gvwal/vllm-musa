From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: wzc-claude <wzc-claude@local>
Date: Tue, 13 Oct 2026 21:00:00 +0800
Subject: [PATCH] MUSA: gather PLE short-conv state rows by advanced indexing

The PLE conv state is a transposed, strided view of the cache. index_select
on a non-contiguous source first makes the whole source contiguous, so every
prefill and decode step copied the entire conv-state pool (about 5.6 ms per
decode step on Qwen3.8-Flash-Next tp8). Advanced indexing gathers through the
strides and touches only the selected rows; the values are identical.

---
--- a/vllm/models/qwen4_exp/nvidia/ple_layer.py
+++ b/vllm/models/qwen4_exp/nvidia/ple_layer.py
@@ -638,7 +638,9 @@
             ].to(device=conv_state.device, dtype=torch.bool)
             has_initial_state = has_initial_state & valid_state
 
-        cached_state = conv_state.index_select(0, state_indices)
+        # MUSA: conv_state is a strided view of the cache; index_select would first
+        # copy the whole pool contiguous, advanced indexing gathers only the rows.
+        cached_state = conv_state[state_indices]
         state = cached_state[..., : self.conv_state_len].to(x_d.dtype)
         if self.conv_state_len > 0:
             initial_state = torch.where(
@@ -751,9 +753,9 @@
                     dtype=x_p.dtype,
                 )
             else:
-                state = conv_state.index_select(0, state_indices)[
-                    ..., : self.conv_state_len
-                ].to(x_p.dtype)
+                state = conv_state[state_indices][..., : self.conv_state_len].to(
+                    x_p.dtype
+                )
             use_initial_mask = (valid_state & has_initial).view(num_prefills, 1, 1)
             initial_state = torch.where(
                 use_initial_mask,
@@ -794,7 +796,7 @@
             # Write back without a host synchronization. Valid, non-empty rows
             # receive their new state; padding and zero-length rows keep the
             # current cache value.
-            existing_state = conv_state.index_select(0, state_indices)
+            existing_state = conv_state[state_indices]
             existing_base_state = existing_state[..., : self.conv_state_len]
             update_mask = valid_state & (lengths.to(device=conv_state.device) > 0)
             safe_next_state = torch.where(
@@ -871,7 +873,7 @@
         packed = packed.transpose(1, 2).contiguous()
 
         if self.conv_state_len > 0:
-            cached_state = conv_state.index_select(0, state_indices)
+            cached_state = conv_state[state_indices]
             rollback_offsets = num_accepted_tokens.to(
                 device=conv_state.device, dtype=torch.int64
             ).sub(1)
