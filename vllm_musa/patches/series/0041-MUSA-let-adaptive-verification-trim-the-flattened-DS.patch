From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Fri, 16 Oct 2026 14:21:02 +0800
Subject: [PATCH] MUSA: let adaptive verification trim the flattened DSA
 indexer decode

MUSA decode always flattens verify tokens into one indexer row per token,
built from device metadata, and its top-k kernels read each row's length on
device. Declare the flattened path tolerant of device-decided query lengths
on MUSA so adaptive verification can trim verify batches.
---
 vllm/v1/attention/backends/mla/indexer.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/vllm/v1/attention/backends/mla/indexer.py b/vllm/v1/attention/backends/mla/indexer.py
index ece1b8d..ef4a836 100644
--- a/vllm/v1/attention/backends/mla/indexer.py
+++ b/vllm/v1/attention/backends/mla/indexer.py
@@ -740,6 +740,10 @@ def _supports_varlen_paged_mqa_logits() -> bool:
 
 
 def _supports_flattened_device_query_lens() -> bool:
+    if current_platform.is_musa():
+        # MUSA: the decode kernels read the per-token rows built from device
+        # metadata, so the flattened path accepts device-decided query lengths.
+        return True
     return (
         current_platform.is_cuda()
         and current_platform.is_device_capability_family(90)
-- 
