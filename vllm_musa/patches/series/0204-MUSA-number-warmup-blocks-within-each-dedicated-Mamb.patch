From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Tue, 27 Oct 2026 10:43:13 +0800
Subject: [PATCH] MUSA: number warmup blocks within each dedicated Mamba pool

---
 vllm/v1/worker/gpu/warmup.py | 61 ++++++++++++++++++++++++++----------
 1 file changed, 44 insertions(+), 17 deletions(-)

diff --git a/vllm/v1/worker/gpu/warmup.py b/vllm/v1/worker/gpu/warmup.py
index b81ddf6d73..4b0cf65b4b 100644
--- a/vllm/v1/worker/gpu/warmup.py
+++ b/vllm/v1/worker/gpu/warmup.py
@@ -84,6 +84,33 @@ def _warmup_block_counter(
     return block_count
 
 
+def _warmup_block_allocator(
+    model_runner: GPUModelRunner,
+) -> Callable[[int, int], list[int]]:
+    """Return `alloc(group_id, num_blocks)` handing out warmup block IDs.
+
+    Groups in the shared KV pool draw distinct IDs from one counter, starting
+    after the null block 0.
+    """
+    kv_cache_config = model_runner.kv_cache_config
+    groups = kv_cache_config.kv_cache_groups
+    # MUSA: each Mamba group may own a dedicated pool sized for max_num_seqs
+    # requests, with its own block-id space.
+    dedicated = bool(kv_cache_config.musa_mamba_num_blocks)
+    shared = len(groups)
+    next_block_ids = [1] * (len(groups) + 1)
+
+    def alloc(group_id: int, num_blocks: int) -> list[int]:
+        pool = shared
+        if dedicated and isinstance(groups[group_id].kv_cache_spec, MambaSpec):
+            pool = group_id
+        start = next_block_ids[pool]
+        next_block_ids[pool] = start + num_blocks
+        return list(range(start, start + num_blocks))
+
+    return alloc
+
+
 def run_mixed_prefill_decode_warmup(
     model_runner: GPUModelRunner,
     worker_execute_model: Callable[[SchedulerOutput], Any],
@@ -130,13 +157,7 @@ def run_mixed_prefill_decode_warmup(
         )
         return False
 
-    next_block_id = 1
-
-    def _alloc_blocks(num_blocks: int) -> list[int]:
-        nonlocal next_block_id
-        block_ids = list(range(next_block_id, next_block_id + num_blocks))
-        next_block_id += num_blocks
-        return block_ids
+    alloc_blocks = _warmup_block_allocator(model_runner)
 
     sampling_params = SamplingParams(
         max_tokens=2,
@@ -155,7 +176,9 @@ def run_mixed_prefill_decode_warmup(
             mm_features=[],
             sampling_params=sampling_params,
             pooling_params=None,
-            block_ids=tuple(_alloc_blocks(n) for n in decode_prefill_block_counts),
+            block_ids=tuple(
+                alloc_blocks(g, n) for g, n in enumerate(decode_prefill_block_counts)
+            ),
             num_computed_tokens=0,
             lora_request=None,
             prefill_token_ids=decode_token_ids,
@@ -166,7 +189,9 @@ def run_mixed_prefill_decode_warmup(
     }
     decode_prefill_output.total_num_scheduled_tokens = decode_prompt_len
 
-    decode_new_blocks = tuple(_alloc_blocks(n) for n in decode_block_deltas)
+    decode_new_blocks = tuple(
+        alloc_blocks(g, n) for g, n in enumerate(decode_block_deltas)
+    )
     cached_decode_req = CachedRequestData.make_empty()
     cached_decode_req.req_ids = [decode_req_id]
     cached_decode_req.num_computed_tokens = [decode_prompt_len]
@@ -185,7 +210,9 @@ def run_mixed_prefill_decode_warmup(
             mm_features=[],
             sampling_params=sampling_params,
             pooling_params=None,
-            block_ids=tuple(_alloc_blocks(n) for n in prefill_block_counts),
+            block_ids=tuple(
+                alloc_blocks(g, n) for g, n in enumerate(prefill_block_counts)
+            ),
             num_computed_tokens=0,
             lora_request=None,
             prefill_token_ids=prefill_token_ids,
@@ -325,11 +352,7 @@ def _warmup_kernels(
         pooling_params = None
 
     # Assign distinct block IDs per request per group. 0 null block, start from 1.
-    next_block_id = 1
-
-    def _alloc_blocks(num_blocks: int) -> list[int]:
-        nonlocal next_block_id
-        return list(range(next_block_id, next_block_id := next_block_id + num_blocks))
+    alloc_blocks = _warmup_block_allocator(model_runner)
 
     # The KV-block zeroing kernel is driven by the scheduler's
     # new_block_ids_to_zero, so none of the steps below reach it.
@@ -346,7 +369,9 @@ def _warmup_kernels(
                 pooling_params,
                 mm_features=warmup_mm_features,
             ),
-            block_ids=tuple(_alloc_blocks(n) for n in prefill_block_counts),
+            block_ids=tuple(
+                alloc_blocks(g, n) for g, n in enumerate(prefill_block_counts)
+            ),
             prefill_token_ids=prompt_token_ids,
         )
         for i in range(num_reqs)
@@ -402,7 +427,9 @@ def _warmup_kernels(
                     for spec, held in zip(kv_cache_specs, req_blocks[i])
                 ]
                 cached_req_data.new_block_ids.append(
-                    tuple(_alloc_blocks(n) for n in deltas) if any(deltas) else None
+                    tuple(alloc_blocks(g, n) for g, n in enumerate(deltas))
+                    if any(deltas)
+                    else None
                 )
                 req_blocks[i] = [
                     held + delta for held, delta in zip(req_blocks[i], deltas)
