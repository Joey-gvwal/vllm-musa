From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MUSA <musa@local>
Date: Fri, 11 Sep 2026 20:00:00 +0800
Subject: [PATCH] MUSA: route QSA through SGLang packed GQA

---
diff --git a/vllm/models/qwen4_exp/amd/ops/qsa.py b/vllm/models/qwen4_exp/amd/ops/qsa.py
index 2e45db711d..f25bedcf90 100644
--- a/vllm/models/qwen4_exp/amd/ops/qsa.py
+++ b/vllm/models/qwen4_exp/amd/ops/qsa.py
@@ -5,6 +5,7 @@
 from __future__ import annotations
 
 import math
+import os
 
 import torch
 
@@ -827,9 +828,38 @@ def qsa_sparse_paged_attention(
     block_table: torch.Tensor,
     token_to_req: torch.Tensor,
     out: torch.Tensor | None = None,
+    sequence_lengths: torch.Tensor | None = None,
+    scale: float | None = None,
+    is_decode: bool = True,
 ) -> torch.Tensor:
     """Run sparse GQA directly over paged BF16 K/V caches."""
 
+    if (
+        os.environ.get("VLLM_MUSA_QSA_SGLANG_PACKED", "1") == "1"
+        and q.device.type == "musa"
+        and q.shape[-1] == 256
+        and is_decode
+    ):
+        if sequence_lengths is None:
+            raise ValueError(
+                "VLLM_MUSA_QSA_SGLANG_PACKED requires sequence_lengths"
+            )
+        from vllm_musa.v1.attention.ops.qwen_qsa_sglang_triton import (
+            sparse_gqa_from_paged_triton,
+        )
+
+        return sparse_gqa_from_paged_triton(
+            q,
+            k_cache,
+            v_cache,
+            block_table,
+            token_to_req,
+            logical_indices,
+            sequence_lengths,
+            q.shape[-1] ** -0.5 if scale is None else scale,
+            out,
+        )
+
     if not q.is_cuda or not HAS_TRITON:
         raise RuntimeError("paged QSA sparse attention requires a GPU and Triton")
     if q.ndim != 3 or k_cache.ndim != 4 or v_cache.shape != k_cache.shape:
diff --git a/vllm/models/qwen4_exp/amd/qsa.py b/vllm/models/qwen4_exp/amd/qsa.py
index 0e65956e96..19f91964c4 100644
--- a/vllm/models/qwen4_exp/amd/qsa.py
+++ b/vllm/models/qwen4_exp/amd/qsa.py
@@ -161,6 +161,9 @@ class Qwen4ExpQSAFlashAttentionImpl(FlashAttentionImpl):
             attn_metadata.block_table,
             token_to_req,
             output[:num_tokens],
+            sequence_lengths=attn_metadata.seq_lens,
+            scale=self.scale,
+            is_decode=attn_metadata.max_query_len == 1,
         )
         return output
 
