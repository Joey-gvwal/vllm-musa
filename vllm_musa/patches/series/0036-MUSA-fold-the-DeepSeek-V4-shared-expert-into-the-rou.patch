From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Tue, 13 Oct 2026 21:00:00 +0800
Subject: [PATCH] MUSA: fold the DeepSeek-V4 shared expert into the routed FP8
 experts

On MUSA the shared expert of a TP-only DeepSeek-V4 MoE with sqrt-softplus
routing has the per-rank shape and FP8 block scales of a routed expert.
The MoE then does not run it beside the routed experts: vllm-musa appends
its projections to the routed expert stack after loading, and the router
routes every token to that extra expert at weight 1.0.
---
 vllm/models/deepseek_v4/nvidia/model.py | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/vllm/models/deepseek_v4/nvidia/model.py b/vllm/models/deepseek_v4/nvidia/model.py
index 2b3a071..d874c96 100644
--- a/vllm/models/deepseek_v4/nvidia/model.py
+++ b/vllm/models/deepseek_v4/nvidia/model.py
@@ -1006,8 +1006,19 @@ class DeepseekV4MoE(nn.Module):
         self.physical_expert_start = self.experts_start_idx
         self.physical_expert_end = self.experts_end_idx
 
+        # MUSA: the shared expert joins the routed FP8 experts as one more expert.
+        musa_shared_fold = False
+        if current_platform.is_musa():
+            from vllm_musa.model_executor.layers.fused_moe.shared_expert_fold import (
+                deepseek_v4_shared_expert_foldable,
+            )
+
+            musa_shared_fold = deepseek_v4_shared_expert_foldable(
+                vllm_config, self, config, quant_config
+            )
+
         self.experts = FusedMoEFactory(
-            shared_experts=self.shared_experts,
+            shared_experts=None if musa_shared_fold else self.shared_experts,
             gate=self.gate,
             num_experts=self.n_routed_experts,
             top_k=self.n_activated_experts,
@@ -1028,6 +1039,12 @@ class DeepseekV4MoE(nn.Module):
             num_redundant_experts=eplb_config.num_redundant_experts,
             is_sequence_parallel=self.use_sequence_parallel,
         )
+        if musa_shared_fold:
+            from vllm_musa.model_executor.layers.fused_moe.shared_expert_fold import (
+                fold_shared_expert,
+            )
+
+            fold_shared_expert(self.experts, self.shared_experts)
 
     def forward(
         self, hidden_states: torch.Tensor, input_ids: torch.Tensor | None = None
-- 
2.25.1

