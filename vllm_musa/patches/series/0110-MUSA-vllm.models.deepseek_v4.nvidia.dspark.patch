From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Fri, 14 Aug 2026 15:00:00 +0800
Subject: [PATCH] MUSA: dispatch DeepSeek-V4 DSpark context KV insert

The upstream DSpark draft model directly invokes CUDA-only
``torch.ops._C`` DeepSeek-V4 KV insertion operators.  The regular
DeepSeek-V4 attention path already dispatches this operation through the
MUSA custom-op wrapper.  Reuse that wrapper for DSpark's context-KV setup so
the draft model follows the same MUSA implementation without changing the
CUDA path.

---
 vllm/models/deepseek_v4/nvidia/dspark.py | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/vllm/models/deepseek_v4/nvidia/dspark.py b/vllm/models/deepseek_v4/nvidia/dspark.py
--- a/vllm/models/deepseek_v4/nvidia/dspark.py
+++ b/vllm/models/deepseek_v4/nvidia/dspark.py
@@ -20,8 +20,9 @@ from vllm.distributed import (
     get_tensor_model_parallel_rank,
     get_tensor_model_parallel_world_size,
 )
 from vllm.logger import init_logger
+from vllm.platforms import current_platform
 from vllm.model_executor.kernels.mhc.tilelang import (
     hc_head_fused_kernel_tilelang,
     mhc_post_tilelang,
 )
@@ -219,6 +219,23 @@ def _insert_context_kv(
         dtype=kv.dtype,
         device=kv.device,
     )
+    if current_platform.is_musa():
+        # The regular DSV4 attention path uses the MUSA wrapper for all cache
+        # layouts. DSpark's context KV has no query result to return, so the
+        # dummy query is passed only for the in-place fused cache insertion.
+        from vllm_musa import _custom_ops as _musa_custom_ops
+
+        _musa_custom_ops.deepseek_v4_qnorm_rope_kv_insert(
+            dummy_q,
+            kv,
+            swa_cache,
+            slot_mapping.contiguous(),
+            positions.contiguous(),
+            cos_sin_cache,
+            attn.eps,
+            block_size,
+        )
+        return
     if cache_dtype == torch.uint8:
         # fp8_ds_mla UE8M0 paged layout
         swa_2d = swa_cache.view(swa_cache.shape[0], -1)
