From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Sat, 10 Oct 2026 17:44:00 +0800
Subject: [PATCH] MUSA: compile the watermark Philox helper on Triton 3.2

The V2 rejection sampler's resample kernel references the watermark
Philox helper, so Triton resolves it on every launch. MUSA Triton 3.2 has
no tl.mul; use the uint32 product, which wraps to the same low word.
---
 vllm/v1/worker/gpu/sample/watermark.py | 20 +++++++++++++++-----
 1 file changed, 15 insertions(+), 5 deletions(-)

diff --git a/vllm/v1/worker/gpu/sample/watermark.py b/vllm/v1/worker/gpu/sample/watermark.py
index 0a9c64c..7d003f8 100644
--- a/vllm/v1/worker/gpu/sample/watermark.py
+++ b/vllm/v1/worker/gpu/sample/watermark.py
@@ -199,11 +199,21 @@ def repeated_context_mask(
     return repeated
 
 
-@triton.jit
-def _mulhilo32(multiplier: tl.constexpr, value):
-    high = tl_math.umulhi(multiplier, value)
-    low = tl.mul(multiplier, value, sanitize_overflow=False)
-    return high, low
+if hasattr(tl, "mul"):
+
+    @triton.jit
+    def _mulhilo32(multiplier: tl.constexpr, value):
+        high = tl_math.umulhi(multiplier, value)
+        low = tl.mul(multiplier, value, sanitize_overflow=False)
+        return high, low
+
+else:
+    # MUSA: Triton 3.2 has no tl.mul; the uint32 product wraps to the low word.
+    @triton.jit
+    def _mulhilo32(multiplier: tl.constexpr, value):
+        high = tl_math.umulhi(multiplier, value)
+        low = multiplier * value
+        return high, low
 
 
 @triton.jit
