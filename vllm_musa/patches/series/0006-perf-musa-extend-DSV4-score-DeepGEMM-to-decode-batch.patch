From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Mon, 28 Sep 2026 14:00:00 +0800
Subject: [PATCH] perf(musa): extend DSV4 score DeepGEMM to decode batches

The score projections with an fp32 output (compressor and indexer
compressor kv_score) take DeepGEMM bf16_gemm_nt up to the multi-stream
token threshold, which covers every DSpark-4 decode batch. The fallback
casts both operands to fp32 and runs a SIMT sgemm, an order of magnitude
slower on S5000 at these sizes. Long prefills above the threshold use the
prefill route.
---
 vllm/models/deepseek_v4/attention.py | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/vllm/models/deepseek_v4/attention.py b/vllm/models/deepseek_v4/attention.py
index f58154d..71b687c 100644
--- a/vllm/models/deepseek_v4/attention.py
+++ b/vllm/models/deepseek_v4/attention.py
@@ -92,7 +92,6 @@ def _fill_short_context_topk_indices(
 
 
 # MUSA: the DeepSeek-V4 attention helpers below branch on the active platform.
-_MUSA_DEEPSEEK_V4_SCORE_FP32_DEEPGEMM_MAX_TOKENS = 16
 
 
 def _musa_deepseek_v4_serialize_long_prefill(num_tokens: int) -> bool:
@@ -117,7 +116,7 @@ def _musa_deepseek_v4_use_score_fp32_deepgemm(
         and a.dtype == torch.bfloat16
         and weight.dtype == torch.bfloat16
         and out_dtype == torch.float32
-        and a.shape[0] <= _MUSA_DEEPSEEK_V4_SCORE_FP32_DEEPGEMM_MAX_TOKENS
+        and a.shape[0] <= envs.VLLM_MULTI_STREAM_GEMM_TOKEN_THRESHOLD
     )
 
 
