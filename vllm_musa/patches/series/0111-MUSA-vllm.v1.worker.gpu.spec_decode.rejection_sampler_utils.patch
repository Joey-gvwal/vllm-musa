From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Fri, 14 Aug 2026 15:20:00 +0800
Subject: [PATCH] MUSA: provide typed optional pointers for DSpark rejection
 sampler

The v0.26 DSpark rejection sampler passes None for draft logits and several
optional verification buffers in greedy mode.  The MUSA Triton frontend
still requires typed pointers even when the corresponding constexpr feature
flag disables the load.  Use one-element device buffers on MUSA; the buffers
are never read when their features are disabled and CUDA behavior is
unchanged.

---
 vllm/v1/worker/gpu/spec_decode/rejection_sampler_utils.py | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/vllm/v1/worker/gpu/spec_decode/rejection_sampler_utils.py b/vllm/v1/worker/gpu/spec_decode/rejection_sampler_utils.py
--- a/vllm/v1/worker/gpu/spec_decode/rejection_sampler_utils.py
+++ b/vllm/v1/worker/gpu/spec_decode/rejection_sampler_utils.py
@@ -899,6 +899,12 @@ def rejection_sample(
         # vocab size is larger than the draft's due to padding.
         vocab_size = min(vocab_size, draft_logits.size(-1))
 
+    # Triton's MUSA backend still requires a typed pointer for optional
+    # tensors even when the corresponding constexpr feature flag is false.
+    # DSpark greedy verification intentionally passes draft_logits=None.
+    if target_logits.device.type == "musa" and draft_logits is None:
+        draft_logits = target_logits.new_empty((1, 1, 1))
+
     # Compute the per-vocab-block logits stats, such as target argmax
     # (for greedy requests), and target max + softmax exponential
     # (for non-greedy requests).
@@ -1021,6 +1027,17 @@ def rejection_sample(
         cumulative_log_p = None
         local_residual_mass = None
 
+    if target_logits.device.type == "musa":
+        # The MUSA Triton frontend cannot infer pointer types from None in
+        # dead constexpr branches. These one-element buffers are never read
+        # when their feature flags are false.
+        if synthetic_conditional_rates is None:
+            synthetic_conditional_rates = target_logits.new_empty((1,))
+        if cumulative_log_p is None:
+            cumulative_log_p = target_logits.new_empty((1,))
+        if local_residual_mass is None:
+            local_residual_mass = target_logits.new_empty((1,))
+
     # Sample up until the first rejected/bonus token, and store
     # the step.
     sampled = draft_sampled.new_empty(
