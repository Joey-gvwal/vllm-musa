From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Wed, 29 Jul 2026 20:23:56 +0800
Subject: [PATCH] MUSA route tf32_hc_prenorm_gemm to mate.deep_gemm and split
 broadcast MHC per K-chunk

---
 vllm/model_executor/kernels/mhc/tilelang.py | 30 ++++++++++++++++-----
 vllm/utils/deep_gemm.py                     | 11 ++++++++
 2 files changed, 34 insertions(+), 7 deletions(-)

diff --git a/vllm/model_executor/kernels/mhc/tilelang.py b/vllm/model_executor/kernels/mhc/tilelang.py
index 57f852c..a330bfa 100644
--- a/vllm/model_executor/kernels/mhc/tilelang.py
+++ b/vllm/model_executor/kernels/mhc/tilelang.py
@@ -391,13 +391,29 @@ def mhc_pre_broadcast_tilelang(
 
     from vllm.utils.deep_gemm import tf32_hc_prenorm_gemm
 
-    tf32_hc_prenorm_gemm(
-        residual_flat,
-        fn_broadcast,
-        gemm_out_mul,
-        gemm_out_sqrsum,
-        n_splits,
-    )
+    if residual.device.type == "musa":
+        # MUSA: mate's tf32_hc_prenorm_gemm writes a single 2D (M, N) tile, not the
+        # 3D per-split output this v0.26 path expects. Produce the split-K partials
+        # by running it on each contiguous K (hidden) chunk; the fuse kernel sums
+        # them, and sum_s x[:,c_s] @ fn[:,c_s].T == x @ fn.T.
+        k_chunk = residual_flat.shape[-1] // n_splits
+        for s in range(n_splits):
+            k0 = s * k_chunk
+            tf32_hc_prenorm_gemm(
+                residual_flat[:, k0 : k0 + k_chunk].contiguous(),
+                fn_broadcast[:, k0 : k0 + k_chunk].contiguous(),
+                gemm_out_mul[s],
+                gemm_out_sqrsum[s],
+                None,
+            )
+    else:
+        tf32_hc_prenorm_gemm(
+            residual_flat,
+            fn_broadcast,
+            gemm_out_mul,
+            gemm_out_sqrsum,
+            n_splits,
+        )
     mhc_pre_big_fuse_broadcast_with_norm_tilelang(
         gemm_out_mul,
         gemm_out_sqrsum,
diff --git a/vllm/utils/deep_gemm.py b/vllm/utils/deep_gemm.py
index 2f287bb..6d5ca23 100644
--- a/vllm/utils/deep_gemm.py
+++ b/vllm/utils/deep_gemm.py
@@ -287,6 +287,17 @@ def _lazy_init() -> None:
         _dg, "get_paged_mqa_logits_metadata", None
     )
     _tf32_hc_prenorm_gemm_impl = getattr(_dg, "tf32_hc_prenorm_gemm", None)
+    if _tf32_hc_prenorm_gemm_impl is None:
+        # MUSA: tf32_hc_prenorm_gemm ships in mate.deep_gemm
+        # (mate::deep_gemm::Mp31Tf32HcPrenormGemm), not the plain deep_gemm build.
+        try:
+            import mate.deep_gemm as _mate_dg
+        except Exception:
+            _mate_dg = None
+        if _mate_dg is not None:
+            _tf32_hc_prenorm_gemm_impl = getattr(
+                _mate_dg, "tf32_hc_prenorm_gemm", None
+            )
     _get_mn_major_tma_aligned_tensor_impl = getattr(
         _dg, "get_mn_major_tma_aligned_tensor", None
     )
