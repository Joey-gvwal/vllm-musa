From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Wed, 30 Sep 2026 10:00:00 +0800
Subject: [PATCH] MUSA: route DeepSeek-V4 prefill score GEMM to DeepGEMM

---
 vllm/models/deepseek_v4/attention.py | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/vllm/models/deepseek_v4/attention.py b/vllm/models/deepseek_v4/attention.py
index f8c383d587..623e8f2b72 100644
--- a/vllm/models/deepseek_v4/attention.py
+++ b/vllm/models/deepseek_v4/attention.py
@@ -66,6 +66,7 @@ from vllm.v1.kv_cache_interface import (
     MLAAttentionSpec,
     get_kv_quant_mode,
 )
+from vllm_musa.optimization_contract import deepseek_v4_prefill_score_deepgemm_enabled
 
 logger = init_logger(__name__)
 
@@ -115,7 +116,15 @@ def _musa_deepseek_v4_use_score_fp32_deepgemm(
         and a.dtype == torch.bfloat16
         and weight.dtype == torch.bfloat16
         and out_dtype == torch.float32
-        and a.shape[0] <= _MUSA_DEEPSEEK_V4_SCORE_FP32_DEEPGEMM_MAX_TOKENS
+        and (
+            a.shape[0] <= _MUSA_DEEPSEEK_V4_SCORE_FP32_DEEPGEMM_MAX_TOKENS
+            # Above the multi-stream threshold the input projections run
+            # serially; score GEMMs there use DeepGEMM, not a SIMT fp32 sgemm.
+            or (
+                deepseek_v4_prefill_score_deepgemm_enabled()
+                and a.shape[0] > envs.VLLM_MULTI_STREAM_GEMM_TOKEN_THRESHOLD
+            )
+        )
     )
 
 
