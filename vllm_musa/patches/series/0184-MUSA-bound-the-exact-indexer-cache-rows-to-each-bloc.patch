From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Tue, 27 Oct 2026 10:43:12 +0800
Subject: [PATCH] MUSA: bound the exact indexer cache rows to each block

---
 vllm/model_executor/layers/sparse_attn_indexer.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/vllm/model_executor/layers/sparse_attn_indexer.py b/vllm/model_executor/layers/sparse_attn_indexer.py
index 66d484a4f9..5a42b21639 100644
--- a/vllm/model_executor/layers/sparse_attn_indexer.py
+++ b/vllm/model_executor/layers/sparse_attn_indexer.py
@@ -989,8 +989,10 @@ def _musa_indexer_cache_block(kv_cache: torch.Tensor, block_id: int) -> torch.Te
 
 
 def _musa_indexer_cache_rows(kv_cache: torch.Tensor) -> torch.Tensor:
+    # One row per block over that block's own bytes: the block stride can also
+    # span other caches that share the page.
     return kv_cache.as_strided(
-        (kv_cache.shape[0], kv_cache.stride(0)),
+        (kv_cache.shape[0], kv_cache[0].numel()),
         (kv_cache.stride(0), 1),
     )
 
