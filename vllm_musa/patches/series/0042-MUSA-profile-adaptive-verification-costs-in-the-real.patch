From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Fri, 16 Oct 2026 16:43:43 +0800
Subject: [PATCH] MUSA: profile adaptive verification costs in the real graph
 capture

The CUDA graph memory profile captures sample FULL graphs and measures the
device memory they take. The adaptive verification step timings ran inside
that pass as eager dummy runs, so their cached activations counted as graph
memory and the KV cache was sized from the inflated estimate. Collect the
step timings only in the real capture.
---
 vllm/v1/worker/gpu/model_runner.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/vllm/v1/worker/gpu/model_runner.py b/vllm/v1/worker/gpu/model_runner.py
index 49607ba..426e253 100644
--- a/vllm/v1/worker/gpu/model_runner.py
+++ b/vllm/v1/worker/gpu/model_runner.py
@@ -1035,7 +1035,10 @@ class GPUModelRunner(LoRAModelRunnerMixin):
                     if self.speculator is not None:
                         with use_workspace_lane(self._draft_workspace_lane):
                             self.speculator.capture()
-                    if self.adaptive_verification is not None:
+                    # The memory-profiling pass captures only sample FULL graphs, so
+                    # its step timings would come from eager runs whose cached
+                    # activations count as graph memory; profile the real capture.
+                    if self.adaptive_verification is not None and not profile_only:
                         with self.step_timing.collect() as timings:
                             for batch in self.adaptive_verification.batches_to_profile(
                                 self.cudagraph_manager.captured_token_counts()
