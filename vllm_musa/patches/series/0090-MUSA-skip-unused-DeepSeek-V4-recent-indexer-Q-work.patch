+    def _build_recent_indices(
+        self,
+        num_tokens: int,
+        num_decode_tokens: int,
+        num_prefill_tokens: int,
+        decode_metadata: DeepSeekV32IndexerDecodeMetadata | None,
+        prefill_metadata: DeepseekV32IndexerPrefillMetadata | None,
+    ) -> torch.Tensor:
+        """Fill the graph recent-window table once per attention metadata.
+
+        The indexer fallback intentionally keeps the most recent compressed
+        tokens rather than evaluating learned Q/weights.  Its input is only
+        the per-token context length, so doing it here avoids repeating the
+        same work in every C4 layer.
+        """
+        assert self.recent_indices_buffer is not None
+        out = self.recent_indices_buffer
+        topk = min(self.model_config.hf_config.index_topk, out.shape[1])
+        rows = min(int(num_tokens), out.shape[0])
+        out[:rows, :topk] = -1
+        if topk <= 0 or rows <= 0:
+            return out
+
+        try:
+            cap = int(os.getenv("VLLM_MUSA_SPARSE_INDEXER_FALLBACK_TOPK", "16"))
+        except ValueError:
+            cap = 16
+        cap = max(0, min(cap, topk))
+        if cap <= 0:
+            return out
+
+        def fill_rows(row_start: int, lengths: torch.Tensor) -> None:
+            start = max(0, int(row_start))
+            if start >= rows:
+                return
+            flat_lengths = lengths.reshape(-1).to(torch.long)
+            count = min(flat_lengths.numel(), rows - start)
+            if count <= 0:
+                return
+            row_lengths = flat_lengths[:count].clamp(min=0)
+            counts = row_lengths.clamp(max=cap)
+            starts = (row_lengths - counts).clamp(min=0)
+            offsets = torch.arange(
+                cap, device=out.device, dtype=torch.long
+            ).unsqueeze(0)
+            values = starts.unsqueeze(-1) + offsets
+            valid = offsets < counts.unsqueeze(-1)
+            rows_view = out[start : start + count, :cap]
+            rows_view.copy_(
+                torch.where(
+                    valid,
+                    values.to(out.dtype),
+                    rows_view,
+                )
+            )
+
+        if num_decode_tokens > 0 and decode_metadata is not None:
+            fill_rows(0, decode_metadata.seq_lens)
+
+        if num_prefill_tokens > 0 and prefill_metadata is not None:
+            for chunk in prefill_metadata.chunks:
+                fill_rows(
+                    int(chunk.token_start),
+                    chunk.cu_seqlen_ke - chunk.cu_seqlen_ks,
+                )
+        return out
+
 
