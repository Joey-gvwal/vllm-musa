From acd886565a0ee92b7da0fceaed7997db26f95c3a Mon Sep 17 00:00:00 2001
From: Joey-gvwal <joey_gvwal@yeah.net>
Date: Mon, 14 Sep 2026 21:08:57 +0800
Subject: [PATCH] MUSA: coalesce short QSA prep head tiles

---
 vllm/models/qwen4_exp/nvidia/ops/qsa_pre_indexer.py | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/vllm/models/qwen4_exp/nvidia/ops/qsa_pre_indexer.py b/vllm/models/qwen4_exp/nvidia/ops/qsa_pre_indexer.py
index d16c4a95fd..6d99bd77f2 100644
--- a/vllm/models/qwen4_exp/nvidia/ops/qsa_pre_indexer.py
+++ b/vllm/models/qwen4_exp/nvidia/ops/qsa_pre_indexer.py
@@ -466,7 +466,15 @@ def qsa_pre_indexer(
     section = mrope_section if mrope_section is not None else (0, 0, 0)
     assert len(section) == 3
 
-    if num_tokens <= 4096:
+    # Decode and short verify batches have only a handful of rows.  Qwen3.8
+    # uses four index-query heads per rank; keeping all four heads in one
+    # program matches the native MUSA prep kernel's one-token/4-warp layout
+    # and avoids splitting a single row across two tiny launches.  Retain the
+    # two-token tile for larger batches, where it gives better reuse of the
+    # position and cache loads.
+    if num_tokens <= 4:
+        TILE_T_Q, TILE_H_Q = 1, 4
+    elif num_tokens <= 4096:
         TILE_T_Q, TILE_H_Q = 2, 2
     else:
         TILE_T_Q, TILE_H_Q = 2, 4
-- 
2.25.1

