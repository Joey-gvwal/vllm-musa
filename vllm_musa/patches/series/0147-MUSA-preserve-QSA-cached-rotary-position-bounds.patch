From efd525b4a9a15b991f44266af383cad1e9dc12dd Mon Sep 17 00:00:00 2001
From: Joey-gvwal <joey_gvwal@yeah.net>
Date: Tue, 15 Sep 2026 10:06:32 +0800
Subject: [PATCH] MUSA: preserve QSA cached rotary position bounds after
 upstream port

---
 vllm/models/qwen4_exp/nvidia/ops/qsa_pre_indexer.py | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/vllm/models/qwen4_exp/nvidia/ops/qsa_pre_indexer.py b/vllm/models/qwen4_exp/nvidia/ops/qsa_pre_indexer.py
index d16c4a95fd..9f0d0a0105 100644
--- a/vllm/models/qwen4_exp/nvidia/ops/qsa_pre_indexer.py
+++ b/vllm/models/qwen4_exp/nvidia/ops/qsa_pre_indexer.py
@@ -147,6 +147,7 @@ def _qsa_pre_indexer_kernel(
     CACHE_HAS_ROPE_POS: tl.constexpr,
     MROPE_H: tl.constexpr,
     MROPE_W: tl.constexpr,
+    MAX_ROPE_POS: tl.constexpr,
 ):
     pid = tl.program_id(0)
     # K work occupies the first programs; the remaining programs tile Q. This
@@ -330,6 +331,17 @@ def _qsa_pre_indexer_kernel(
                 pos_t = tl.where(first_in_chunk, first_pos_t.to(tl.int64), cached_pos_t)
                 pos_h = tl.where(first_in_chunk, first_pos_h.to(tl.int64), cached_pos_h)
                 pos_w = tl.where(first_in_chunk, first_pos_w.to(tl.int64), cached_pos_w)
+                # Recycled side-cache pages can carry stale MRoPE tails. Keep
+                # those values from becoming unchecked rotary-cache addresses.
+                pos_t = tl.where(
+                    (pos_t >= 0) & (pos_t < MAX_ROPE_POS), pos_t, first_position
+                )
+                pos_h = tl.where(
+                    (pos_h >= 0) & (pos_h < MAX_ROPE_POS), pos_h, first_position
+                )
+                pos_w = tl.where(
+                    (pos_w >= 0) & (pos_w < MAX_ROPE_POS), pos_w, first_position
+                )
             else:
                 pos_t = first_position
                 pos_h = first_position
@@ -516,6 +528,7 @@ def qsa_pre_indexer(
         CACHE_HAS_ROPE_POS=cache_has_rope_pos,
         MROPE_H=section[1],
         MROPE_W=section[2],
+        MAX_ROPE_POS=cos_sin_cache.shape[0],
         num_warps=1,
     )
 
-- 
2.25.1

