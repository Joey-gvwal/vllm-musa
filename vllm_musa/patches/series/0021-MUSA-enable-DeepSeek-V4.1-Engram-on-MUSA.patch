From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Sat, 10 Oct 2026 19:17:36 +0800
Subject: [PATCH] MUSA: enable DeepSeek-V4.1 Engram on MUSA

Create and accept the Engram configuration on MUSA as on CUDA, and load
power-of-two float32 Engram scales as their ue8m0 exponent bytes.
---
 vllm/config/engram.py                     | 5 +++--
 vllm/config/vllm.py                       | 7 ++++---
 vllm/models/deepseek_v41/common/engram.py | 8 +++++++-
 3 files changed, 14 insertions(+), 6 deletions(-)

diff --git a/vllm/config/engram.py b/vllm/config/engram.py
index 5abb2bd..1014188 100644
--- a/vllm/config/engram.py
+++ b/vllm/config/engram.py
@@ -71,15 +71,16 @@ class EngramConfig:
             if model_config is not None
             else None
         )
+        on_musa = getattr(current_platform, "is_musa", lambda: False)()
         if (
             model_config is None
             or field is None
-            or not current_platform.is_cuda()
+            or not (current_platform.is_cuda() or on_musa)
             or not getattr(model_config.hf_text_config, field, None)
         ):
             raise ValueError(
                 "EngramConfig requires a model with supported Engram "
-                "embeddings, non-empty n-gram layer ids, and CUDA."
+                "embeddings, non-empty n-gram layer ids, and CUDA or MUSA."
             )
 
     def verify_parallel_config(self, parallel_config: "ParallelConfig") -> None:
diff --git a/vllm/config/vllm.py b/vllm/config/vllm.py
index 3b8521b..9b5206b 100644
--- a/vllm/config/vllm.py
+++ b/vllm/config/vllm.py
@@ -1250,9 +1250,10 @@ class VllmConfig:
                 "Disable --enable-dbo and set --ubatch-size to 0."
             )
         if self.engram_config is None:
-            if not current_platform.is_cuda() or not model_has_engram_layers(
-                model_config
-            ):
+            on_musa = getattr(current_platform, "is_musa", lambda: False)()
+            if not (
+                current_platform.is_cuda() or on_musa
+            ) or not model_has_engram_layers(model_config):
                 return
             self.engram_config = EngramConfig()
         self.engram_config.verify_model_config(model_config)
diff --git a/vllm/models/deepseek_v41/common/engram.py b/vllm/models/deepseek_v41/common/engram.py
index c415bba..119d51c 100644
--- a/vllm/models/deepseek_v41/common/engram.py
+++ b/vllm/models/deepseek_v41/common/engram.py
@@ -564,11 +564,17 @@ def _engram_head_shard_weight_loader(
     param: torch.nn.Parameter, loaded_weight: torch.Tensor
 ) -> None:
     """Load this rank's complete head buckets. ue8m0 scales arrive as
-    float8_e8m0fnu; keep the raw bytes (the param stores uint8)."""
+    float8_e8m0fnu, or as power-of-two float32 whose exponent field is the
+    ue8m0 byte; keep the raw bytes (the param stores uint8)."""
     part_rows = param.shape[0]
     if loaded_weight.dtype == torch.float8_e8m0fnu:
         loaded_weight = loaded_weight.view(torch.uint8)
     shard = loaded_weight.narrow(0, param.engram_vocab_start, part_rows)
+    if param.dtype == torch.uint8 and shard.dtype == torch.float32:
+        bits = shard.contiguous().view(torch.int32)
+        if (bits <= 0).any() or (bits & 0x7FFFFF).any():
+            raise ValueError("float32 engram scales must be positive powers of two")
+        shard = ((bits >> 23) & 0xFF).to(torch.uint8)
     assert shard.shape == param.shape, (
         f"engram shard {tuple(shard.shape)} does not fit param {tuple(param.shape)}"
     )
