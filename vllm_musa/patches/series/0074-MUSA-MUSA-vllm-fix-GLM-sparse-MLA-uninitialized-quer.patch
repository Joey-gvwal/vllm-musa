From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: musa <musa@local>
Date: Tue, 27 Oct 2026 10:43:06 +0800
Subject: [PATCH] MUSA: MUSA(vllm): fix GLM sparse MLA uninitialized query
 buffers

---
 vllm/v1/attention/backends/mla/flashmla_sparse.py | 14 ++++++++------
 1 file changed, 8 insertions(+), 6 deletions(-)

diff --git a/vllm/v1/attention/backends/mla/flashmla_sparse.py b/vllm/v1/attention/backends/mla/flashmla_sparse.py
index 3cf0c33c53..24f6e8d40e 100644
--- a/vllm/v1/attention/backends/mla/flashmla_sparse.py
+++ b/vllm/v1/attention/backends/mla/flashmla_sparse.py
@@ -1304,7 +1304,7 @@ class FlashMLASparseImpl(SparseMLACommonImpl[FlashMLASparseMetadata]):
             softmax_scale=self.softmax_scale,
         )
 
-        # Slice output and lse back to actual head count if we padded
+        # Slice output back to actual head count if we padded
         if actual_num_heads < padded_num_heads:
             out = out[:, :, :actual_num_heads, :]
             lse = lse[:, :actual_num_heads, :]
@@ -1408,18 +1408,20 @@ class FlashMLASparseImpl(SparseMLACommonImpl[FlashMLASparseMetadata]):
         actual_num_heads = self.num_heads
         if isinstance(q, tuple):
             ql_nope, q_pe = q
-            q_concat_buffer, *_ = current_workspace_manager().get_simultaneous(
-                *self.workspace_specs
-            )
-            q = q_concat_buffer[: ql_nope.shape[0]]
             if q_pe.size(-1) == 0:
+                q_concat_buffer, *_ = current_workspace_manager().get_simultaneous(
+                    *self.workspace_specs
+                )
+                q = q_concat_buffer[: ql_nope.shape[0]]
                 # NoPE (GLM5Next): concat_mla_q requires rope_dim == 64,
                 # copy directly into the head-padded buffer instead.
                 q[:, : ql_nope.shape[1], : self.kv_lora_rank].copy_(ql_nope)
                 if self.q_head_size > self.kv_lora_rank:
                     q[..., self.kv_lora_rank :].zero_()
             else:
-                ops.concat_mla_q(ql_nope, q_pe, q)
+                # MUSA: concat_mla_q leaves the reused q_concat_buffer partially
+                # written (stale NaN/garbage); use a fresh full-write cat instead.
+                q = torch.cat([ql_nope, q_pe], dim=-1)
         else:
             actual_num_heads = q.shape[1]
             if q.shape[-1] < self.q_head_size:
