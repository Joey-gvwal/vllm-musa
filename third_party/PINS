# Single source of truth for the upstream pins (the MDM).
# Read by BOTH setup.py (regex) and Makefile.sync ($(shell sed)) so a version
# bump edits ONE place and the generation base can never desync from the build
# base. KEY=VALUE only — NOT TOML (tomllib is 3.11+, the build box is py3.10,
# the package floor is 3.10), so the build needs no parser dependency.
# Human-readable release label plus the immutable source commit used by builds.
# releases/v0.28.0 is pinned to the exact commit validated by this branch; never
# build from the moving release branch alone.
VLLM_TAG=v0.28.0
VLLM_COMMIT=9991487661f64176bbf9a4bea6c4d91b96c9ae6e
# FlashInfer is intentionally DECOUPLED from upstream vLLM's choice. This is the
# validated sampling/norm source revision; bump it consciously, not in lockstep
# with VLLM_TAG/VLLM_COMMIT.
FLASHINFER_COMMIT=bc29697ba20b7e6bdb728ded98f04788e16ee021
